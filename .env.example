# Backend configuration (copy to backend/.env). Everything defaults to a fully simulated, offline setup.
DATABASE_URL=sqlite:///./dev.db
JWT_SECRET=change-me-to-a-long-random-string-32+
CORS_ORIGINS=http://localhost:5173

# Payments: "fake" (simulated, no network) or "stripe" (TEST MODE keys only: sk_test_...)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: "fake" (logged only) or "resend"
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM=Corgi Demo <onboarding@resend.dev>
